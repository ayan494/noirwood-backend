            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"John Doe\",\n  \"email\": \"johndoe@example.com\",\n  \"productName\": \"Test Sofa\",\n  \"productSlug\": \"test-sofa\",\n  \"message\": \"I want to know the price\"\n}"
